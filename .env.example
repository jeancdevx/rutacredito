# Ninguna variable ni clave de API es necesaria para las funciones de RutaCréditos.
# Opcional: URL pública REAL para canonical y Open Graph, sin barra final.
# En Vercel se detecta VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automáticamente.
NEXT_PUBLIC_SITE_URL=

# Solo para pruebas locales: ruta de un Chromium instalado, si no usas el de Playwright.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# La generación y el render actuales son locales y no requieren credenciales.
# Solo si se elige en el futuro generar clips con HeyGen desde HyperFrames:
# HEYGEN_API_KEY=
# Nunca uses NEXT_PUBLIC_ para una clave de generación. No pertenece al cliente.
